# Generate random values with: openssl rand -hex 32
ELASTIC_MEMORY_SIZE=4G
ELASTICSEARCH_HOST_PORT=9200
ELASTIC_PASSWORD=REPLACE_WITH_RANDOM_HEX

OPENCTI_NODE_MEMORY_SIZE=4096
OPENCTI_EXTERNAL_SCHEME=http
OPENCTI_HOST=opencti.example.local
OPENCTI_PORT=8080
OPENCTI_ADMIN_EMAIL=admin@example.local
OPENCTI_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
OPENCTI_ADMIN_TOKEN=REPLACE_WITH_RANDOM_HEX
OPENCTI_ENCRYPTION_KEY=REPLACE_WITH_32_HEX_CHARACTERS
OPENCTI_HEALTHCHECK_ACCESS_KEY=REPLACE_WITH_RANDOM_HEX

MINIO_ROOT_USER=opencti
MINIO_ROOT_PASSWORD=REPLACE_WITH_RANDOM_HEX
RABBITMQ_DEFAULT_USER=opencti
RABBITMQ_DEFAULT_PASS=REPLACE_WITH_RANDOM_HEX

# Configure a real SMTP hostname if email notifications are needed.
SMTP_HOSTNAME=localhost
SMTP_PORT=25
